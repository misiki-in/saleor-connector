{
  "name": "@misiki/saleor-connector",
  "version": "1.0.3",
  "description": "API Connector for Saleor with Svelte Commerce",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js",
      "require": "./dist/services/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "p": "tsup && npm publish --access public",
    "dev": "tsup --watch"
  },
  "keywords": [
    "saleor",
    "litekart",
    "connector",
    "ecommerce",
    "headless",
    "graphql",
    "storefront",
    "api",
    "integration",
    "typescript",
    "svelte"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.2",
  "dependencies": {
    "graphql-request": "7.4.0"
  }
}
